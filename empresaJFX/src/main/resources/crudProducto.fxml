<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="566.0" prefWidth="429.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.empresajfx.viewController.ProductoViewController">
    <children>
        <Label layoutX="118.0" layoutY="20.0" text="Gestión Productos">
            <font><Font name="System Bold" size="18.0" /></font>
        </Label>
        <Label layoutX="41.0" layoutY="70.0" text="Código:"><font><Font size="18.0" /></font></Label>
        <Label layoutX="41.0" layoutY="105.0" text="Nombre:"><font><Font size="18.0" /></font></Label>
        <Label layoutX="41.0" layoutY="140.0" text="Precio:"><font><Font size="18.0" /></font></Label>
        <TextField fx:id="txtCodigo" layoutX="126.0" layoutY="71.0" prefWidth="194.0" />
        <TextField fx:id="txtNombre" layoutX="126.0" layoutY="106.0" prefWidth="194.0" />
        <TextField fx:id="txtPrecio" layoutX="126.0" layoutY="141.0" prefWidth="194.0" />
        <Button fx:id="btnAgregarProducto" layoutX="64.0" layoutY="195.0" onAction="#onAgregarProducto" text="Agregar producto" />
        <Button fx:id="btnActualizarProducto" layoutX="200.0" layoutY="195.0" onAction="#onActualizarProducto" text="Actualizar producto" />
        <TableView fx:id="tblListProducto" layoutX="7.0" layoutY="250.0" prefHeight="230.0" prefWidth="412.0">
            <columns>
                <TableColumn fx:id="tbcCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="tbcNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="tbcPrecio" prefWidth="100.0" text="Precio" />
            </columns>
        </TableView>
        <Button fx:id="btnLimpiar" layoutX="93.0" layoutY="500.0" onAction="#onLimpiar" prefWidth="106.0" text="Limpiar" />
        <Button fx:id="btnEliminar" layoutX="234.0" layoutY="500.0" onAction="#onEliminar" prefWidth="97.0" text="Eliminar" />
    </children>
</AnchorPane>